# انسخ هذا الملف إلى .env.local وعدّل القيم. لا ترفع .env.local أبداً.
# Copy to .env.local and adjust. Never commit .env.local.

# عنوان الـ Backend API (بدون / في النهاية). الافتراضي في lib/api.ts هو سيرفر الإنتاج.
# Backend API base URL (no trailing slash).
NEXT_PUBLIC_API_URL=https://yosaal-website-backend.onrender.com/api/v1

# الرابط العام للموقع (للروابط الكاملة وSEO).
# Public site URL (absolute links / SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# السماح بالفهرسة: الافتراضي مسموح. اضبطها false لمنع محركات البحث (تُمنع تلقائياً في VERCEL_ENV=preview/development).
# Indexing is allowed by default; set to "false" to block crawlers (Vercel preview/development deployments are blocked automatically).
# NEXT_PUBLIC_ALLOW_INDEXING=true
